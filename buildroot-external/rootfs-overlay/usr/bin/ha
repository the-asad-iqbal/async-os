#!/bin/sh
# ==============================================================================
# HA utility
# ==============================================================================

# Show the AsyncOS banner instead of the Home Assistant one
case "$1" in
	banner|ba)
		exec /usr/libexec/asyncos-banner
		;;
esac

if [ -t 1 ]; then
	# stdout (fd 1) must be terminal, otherwise `-t` causes error
	docker exec -it hassio_cli ha "$@"
else
	docker exec -i hassio_cli ha "$@"
fi
