[Unit]
Description=AsyncOS firewall
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
After=systemd-modules-load.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /usr/lib/asyncos/firewall.nft
ExecReload=/usr/sbin/nft -f /usr/lib/asyncos/firewall.nft

[Install]
WantedBy=sysinit.target
