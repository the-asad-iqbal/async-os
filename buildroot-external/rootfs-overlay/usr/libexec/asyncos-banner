#!/bin/sh
# ==============================================================================
# AsyncOS console banner: logo, system status and where to reach the device
#
# Usage: asyncos-banner [--console]
#   --console  add the hint for the status screen on the device console
# ==============================================================================
# shellcheck disable=SC1091
. /usr/lib/os-release

# Brand palette, see branding/colors.json "terminal"
P='\033[1;38;5;63m'  # indigo
A='\033[1;38;5;45m'  # pulse
W='\033[1;97m'
M='\033[38;5;245m'
OK='\033[1;32m'
WARN='\033[1;33m'
R='\033[0m'

hostname="$(cat /proc/sys/kernel/hostname)"

logo() {
    printf '%b\n' "" \
    "${P}       ${R}  ${W} ███                             ${R}  ${P} ███    ████${R}" \
    "${P} ▄▀ ▀▄ ${R}  ${W}█   █   ████  █   █  ████    ████${R}  ${P}█   █  █    ${R}" \
    "${P}▄▀ ${A}■${P} ▀▄${R}  ${W}█████  ███     █ █   █   █  █    ${R}  ${P}█   █   ███ ${R}" \
    "${P}▀     ▀${R}  ${W}█   █    ███    █    █   █  █    ${R}  ${P}█   █      █${R}" \
    "${P}       ${R}  ${W}█   █  ████     █    █   █   ████${R}  ${P} ███   ████ ${R}" \
    ""
}

row() {
    printf "  %b%-12s%b%b\n" "${M}" "$1" "${R}" "$2"
}

status() {
    case "$(systemctl is-system-running 2>/dev/null)" in
        running) echo "${OK}●${R} Running" ;;
        starting|initializing) echo "${WARN}●${R} Starting" ;;
        degraded) echo "${WARN}●${R} Degraded ${M}(see 'systemctl --failed')${R}" ;;
        *) echo "${WARN}●${R} Unknown" ;;
    esac
}

# Addresses on physical and user-configured links, without container bridges
addresses() {
    ip -j "-$1" addr show scope global 2>/dev/null | jq -r '
        .[]
        | select(.ifname | test("^(lo|veth)") | not)
        | .ifname as $ifname
        | .addr_info[]
        | "\(.local)/\(.prefixlen) \u001b[38;5;245m(\($ifname))\u001b[0m"'
}

print_addresses() {
    label="$1"
    list="$(addresses "$2")"
    if [ -z "${list}" ]; then
        if [ "$2" = 4 ]; then
            row "${label}" "${M}No address${R}"
        fi
        return
    fi
    echo "${list}" | while IFS= read -r address; do
        row "${label}" "${address}"
        label=""
    done
}

logo
printf "%b%s%b %b%s · %s%b\n\n" "${W}" "${NAME}" "${R}" "${M}" "${VERSION_ID}" "${VARIANT#"${NAME} "}" "${R}"
row "Status" "$(status)"
row "Hostname" "${hostname}"
print_addresses "IPv4" 4
print_addresses "IPv6" 6
row "Dashboard" "${A}http://${hostname}.local${R}"

# Until the first owner account exists, show the one-time setup code. It
# proves physical access to whoever finishes setup in the browser.
setup_code="$(cat /mnt/data/asyncos/setup-code 2>/dev/null)"
if [ -n "${setup_code}" ]; then
    printf "\n"
    row "Setup code" "${W}${setup_code}${R}  ${M}enter it in the web UI to create the owner account${R}"
fi
if [ "$1" = "--console" ]; then
    printf "\n%bOpen the dashboard in a browser to manage this controller. Press Enter to refresh.%b\n" "${M}" "${R}"
fi
printf "\n"
