{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],

  "enabledManagers": ["custom.regex", "github-actions", "pip_requirements"],
  "ignorePaths": [],

  "semanticCommits": "disabled",
  "labels": ["dependencies"],
  "commitMessageExtra": "to {{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if isSingleVersion}}{{prettyNewVersion}}{{else}}{{#if newValue}}{{{newValue}}}{{else}}{{{newDigestShort}}}{{/if}}{{/if}}{{/if}}",

  "customDatasources": {
    "kernel-org": {
      "description": "Latest release of each stable and longterm kernel series, as published by kernel.org",
      "defaultRegistryUrlTemplate": "https://www.kernel.org/releases.json",
      "transformTemplates": [
        "{\"releases\": releases[moniker in [\"stable\", \"longterm\"]].{\"version\": version, \"releaseTimestamp\": released.isodate}}"
      ]
    }
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "Mainline kernel version of the boards that build from kernel.org",
      "managerFilePatterns": ["/^buildroot-external/configs/[^/]+_defconfig$/"],
      "matchStrings": [
        "BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "linux",
      "datasourceTemplate": "custom.kernel-org",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Mainline kernel versions in the documentation, kept in sync with the defconfigs.",
      "managerFilePatterns": ["/^Documentation/kernel\\.md$/"],
      "matchStrings": ["\\| (?<currentValue>\\d+\\.\\d+\\.\\d+) \\|"],
      "depNameTemplate": "linux",
      "datasourceTemplate": "custom.kernel-org",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "tempio",
      "managerFilePatterns": [
        "/^buildroot-external/package/tempio/tempio\\.mk$/"
      ],
      "matchStrings": ["TEMPIO_VERSION = (?<currentValue>\\S+)"],
      "depNameTemplate": "home-assistant/tempio",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    }
  ],

  "packageRules": [
    {
      "description": "Label GitHub Actions updates like Dependabot did, and keep them weekly",
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"],
      "schedule": ["before 8am on monday"]
    },
    {
      "description": "Leave runner labels and action version inputs alone, Dependabot never updated those",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["github-runner", "uses-with"],
      "enabled": false
    },
    {
      "description": "Group the actions/cache subactions into one PR (they share a release)",
      "matchPackageNames": ["/^actions\\/cache(?:\\/|$)/"],
      "groupName": "actions/cache",
      "groupSlug": "actions-cache"
    },
    {
      "description": "Mainline kernel: one PR for all boards and the documentation, in the same format as the manual kernel updates",
      "matchDatasources": ["custom.kernel-org"],
      "groupName": "Linux kernel",
      "groupSlug": "linux-kernel",
      "rebaseWhen": "never",
      "commitMessagePrefix": "Linux:",
      "commitMessageAction": "Update",
      "commitMessageTopic": "kernel",
      "commitMessageExtra": "to {{newVersion}}",
      "prBodyNotes": [
        "* https://cdn.kernel.org/pub/linux/kernel/v{{newMajor}}.x/ChangeLog-{{newVersion}}"
      ],
      "commitBody": "* https://cdn.kernel.org/pub/linux/kernel/v{{newMajor}}.x/ChangeLog-{{newVersion}}",
      "addLabels": ["linux"]
    },
    {
      "description": "Stay on the kernel series the boards are on. Moving to a new series is a deliberate change.",
      "matchDatasources": ["custom.kernel-org"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "tempio, with links to the release notes",
      "matchPackageNames": ["home-assistant/tempio"],
      "commitMessageTopic": "tempio",
      "fetchChangeLogs": "branch",
      "commitBody": "Full changelog:\n{{#if logJSON.versions}}{{#each logJSON.versions}}* https://github.com/home-assistant/tempio/releases/tag/{{version}}\n{{/each}}{{else}}* https://github.com/home-assistant/tempio/releases/tag/{{newVersion}}{{/if}}",
      "addLabels": ["os"]
    },
    {
      "description": "Python packages of the tests, in the same format as the manual updates",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["tests/**"],
      "commitMessagePrefix": "Tests:",
      "commitMessageAction": "update",
      "commitMessageTopic": "{{depName}}"
    },
    {
      "description": "labgrid, with links to the release notes. Its release tags have a v prefix.",
      "matchPackageNames": ["labgrid"],
      "fetchChangeLogs": "branch",
      "commitBody": "Full changelog:\n{{#if logJSON.versions}}{{#each logJSON.versions}}* https://github.com/labgrid-project/labgrid/releases/tag/v{{version}}\n{{/each}}{{else}}* https://github.com/labgrid-project/labgrid/releases/tag/v{{newVersion}}{{/if}}",
      "addLabels": ["build", "run-ova-test"]
    }
  ]
}
